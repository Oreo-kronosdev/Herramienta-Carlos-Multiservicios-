# Copia este archivo a .env.local y rellena los valores.
# En local salen de `npx supabase status`; en la nube, de Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Clave secreta (service role). Solo en el servidor; nunca la compartas ni la subas al repo.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Avisos en el móvil (genera las claves con: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Un email de contacto (lo piden los servicios de notificaciones)
VAPID_SUBJECT=mailto:tu-email@ejemplo.com
# Contraseña larga cualquiera; Vercel la usa para llamar al aviso diario
CRON_SECRET=
